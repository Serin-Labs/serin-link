CONFIG_SERIN_BOARD_VIEWE_15=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Trim for the kit enclosure (carrier PCB + printed stand); a different
# enclosure, or a bare display module, needs its own. The `sensor-offset`
# console command writes a per-device NVS override that wins over this.
CONFIG_SERIN_SHT40_OFFSET_CC=100
CONFIG_SERIN_SHT40_IDLE_OFF_DELTA_CC=0

# Humidity gain as a ratio. A per-device `sensor-offset` does not change it.
CONFIG_SERIN_SHT40_RH_GAIN_PPT=1110
